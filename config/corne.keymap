#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT_L 0
#define SYMBOLS_L 1
#define ARROWS_L  2
#define NUMBERS_L 3

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        a {
            bindings = <&kp ESCAPE>;
            key-positions = <2 1>;
        };

        b {
            bindings = <&kp TAB>;
            key-positions = <14 13>;
        };

        c {
            bindings = <&kp CAPSLOCK>;
            key-positions = <26 25>;
        };

        d {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 9>;
        };

        e {
            bindings = <&kp ENTER>;
            key-positions = <22 21>;
        };

        h {
            bindings = <&sys_reset>;
            key-positions = <1 29>;
        };

        j {
            bindings = <&sys_reset>;
            key-positions = <30 10>;
        };

        Del {
            bindings = <&kp DELETE>;
            key-positions = <9 10 11>;
        };

        accent {
            bindings = <&kp GRAVE>;
            key-positions = <39 38>;
        };

        mute {
            bindings = <&kp C_MUTE>;
            key-positions = <29 28>;
        };

        task_manager {
            bindings = <&kp C_AL_TASK_MANAGER>;
            key-positions = <0 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "0";
            bindings = <
&kp ESC       &kp Q  &kp W  &kp E         &kp R           &kp T                 &lt 4 Y      &kp U     &kp I              &kp O    &kp P        &kp BSPC
&kp CAPSLOCK  &kp A  &kp S  &kp D         &kp F           &kp G                 &kp H        &kp J     &kp K              &kp L    &lt 1 SEMI   &kp RET
&kp TAB       &kp Z  &kp X  &kp C         &kp V           &kp B                 &kp N        &kp M     &kp COMMA          &kp DOT  &lt 2 MINUS  &kp RSHFT
                            &kp LEFT_ALT  &kp LEFT_SHIFT  &mt LCTRL LEFT_WIN    &lt 3 SPACE  &kp HOME  &mt RIGHT_ALT END
            >;
        };

        number_media_layer {
            label = "1";
            bindings = <
&none  &none           &none       &none             &none         &none              &none  &kp N1  &kp N2  &kp N3  &none  &none
&none  &none           &none       &none             &none         &none              &none  &kp N4  &kp N5  &kp N6  &none  &none
&none  &kp C_PREVIOUS  &kp C_NEXT  &kp C_PLAY_PAUSE  &kp C_VOL_DN  &kp C_VOLUME_UP    &none  &kp N7  &kp N8  &kp N9  &none  &none
                                   &none             &none         &none              &none  &none   &kp N0
            >;
        };

        arrow_topSymbols_layer {
            label = "2";
            bindings = <
&none  &kp LS(EXCL)  &kp LS(DQT)  &kp LS(POUND)  &kp LS(DLLR)    &kp LS(PRCNT)    &kp LS(AMPS)  &kp LS(FSLH)    &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(EQUAL)  &none
&none  &none         &none        &none          &none           &none            &none         &none           &kp UP_ARROW  &none         &none          &none
&none  &none         &none        &none          &none           &none            &none         &kp LEFT_ARROW  &kp DOWN      &kp RIGHT     &none          &none
                                  &none          &kp LEFT_SHIFT  &none            &none         &kp HOME        &kp END
            >;
        };

        symbols_layer {
            bindings = <
&kp PIPE       &trans            &kp AT       &kp HASH       &kp DOLLAR  &kp LS(LBKT)    &kp LS(RBKT)  &kp QUESTION      &kp PLUS           &kp ASTRK     &trans         &none
&trans         &trans            &kp PERCENT  &kp AMPERSAND  &kp SLASH   &kp LBRC        &kp RBRC      &kp BACKSLASH     &kp SLASH          &kp GRAVE     &kp CARET      &kp TILDE
&kp LESS_THAN  &kp GREATER_THAN  &trans       &trans         &trans      &kp LS(LPAR)    &kp LS(RPAR)  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp LS(SEMI)  &kp LS(COLON)  &kp LS(UNDER)
                                              &trans         &trans      &trans          &trans        &trans            &trans
            >;
        };

        bt_layer {
            label = "4";
            bindings = <
&kp ESC       &kp LS(N1)    &kp LS(N2)    &kp LS(N3)    &kp LS(N4)    &kp LS(N5)     &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &none
&none         &none         &none         &none         &none         &bt BT_CLR     &none       &none       &none       &none       &none       &none
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bootloader    &none       &none       &none       &none       &none       &none
                                          &none         &none         &none          &none       &none       &none
            >;
        };
    };
};